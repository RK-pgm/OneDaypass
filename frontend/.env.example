# DayPass — Frontend Environment Variables
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามจริง

# API URL ของ backend (เปลี่ยนเมื่อ deploy)
VITE_API_URL=http://localhost:5000/api

# เปิด DEMO_MODE เพื่อแสดงปุ่ม "จำลองเช็กอิน"
VITE_DEMO_MODE=true

# Google OAuth 2.0 Client ID (สำหรับล็อกอินด้วย Google จริง)
# สร้างจาก https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=66274212738-mn58k9bda2n8ig62m0ifa8dcavitkcoa.apps.googleusercontent.com
